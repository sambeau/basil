// Abbr - Abbreviation with required expansion
// Usage: <Abbr title="HyperText Markup Language">"HTML"</Abbr>

export Abbr = fn({title, id, class, contents}) {
    if (title == null || title == "") {
        fail("Abbr requires a title attribute (the expanded form of the abbreviation)")
    }
    <abbr id={id} class={class} title={title}>(contents)</abbr>
}
