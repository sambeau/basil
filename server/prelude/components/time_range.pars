// TimeRange - Smart display of datetime spans
// Renders a <time-range> custom element
// Usage: <TimeRange start={session.start} end={session.end}/>

export TimeRange = fn({start, end, format, separator, id, class, contents}) {
    // Format datetime attributes (ISO 8601)
    let startIso = if (start) start.iso else null
    let endIso = if (end) end.iso else null
    let sep = separator ?? " – "

    // Compute server-side fallback display
    let display = if (contents) {
        contents
    } else if (start != null && end != null) {
        // Smart formatting based on date comparison
        let sameDay = start.date == end.date
        let sameMonth = start.month == end.month && start.year == end.year
        let sameYear = start.year == end.year

        if (sameDay) {
            // Same day: show date once, both times
            start.format("long") + ", " + start.time + sep + end.time
        } else if (sameMonth) {
            // Same month: collapse to short range
            start.format("medium") + sep + toString(end.day) + ", " + toString(end.year)
        } else if (sameYear) {
            // Same year: show both dates without repeating year
            start.format("medium") + sep + end.format("medium")
        } else {
            // Different years
            start.format("long") + sep + end.format("long")
        }
    } else {
        ""
    }

    // Title shows full range in UTC
    let title = if (start != null && end != null) {
        start.format("full") + " – " + end.format("full") + " UTC"
    } else {
        null
    }

    <time-range
        start={startIso}
        end={endIso}
        format={format}
        separator={separator}
        id={id}
        class={class}
        title={title}
    >
        display
    </time-range>
}
