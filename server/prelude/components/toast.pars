// Toast - Individual notification message
// Compatible with Pico CSS - uses <article> with role and data-type attributes
// Requires basil-supplement.css for type-specific styling (border colors)
// Usage: <Toast message="Changes saved" type="success"/>
// Usage: <Toast message="Error occurred" type="error" dismissible={false}/>

export Toast = fn({message, type, dismissible, ...attrs}) {
    let toastType = type ?? "info"
    let canDismiss = dismissible ?? true
    let role = if (toastType == "error") { "alert" } else { "status" }

    <article role={role} data-type={toastType} {...attrs}>
        <p>message</p>
        if (canDismiss) {
            <button aria-label="Dismiss" onclick="this.parentElement.remove()"/>
        }
    </article>
}
