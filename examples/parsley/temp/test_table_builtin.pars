// Test Table() builtin constructor

// T1.1: Constructor with valid array
let t = Table([{a: 1, b: 2}, {a: 3, b: 4}])
log("Length:", t.length)     // Expected: 2
log("Columns:", t.columns)   // Expected: ["a", "b"]
log("")

// T1.2: Empty table
let empty = Table([])
log("Empty length:", empty.length)     // Expected: 0
log("Empty columns:", empty.columns)   // Expected: []
log("")

// T1.3: No args (empty table)
let noArgs = Table()
log("No args length:", noArgs.length)  // Expected: 0
log("")

// T1.4: Schema property (null when no schema)
log("Schema:", t.schema)               // Expected: null
log("")

// T1.5: Test with Inspect
log("Inspect:", t)                     // Expected: Table(2 rows)
