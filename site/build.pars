// Static site generator for herbaceous.net.
//
// Run from the site/ directory:   pars build.pars
// Output goes to site/dist/, which the Pages workflow deploys.
//
// Yes, this site is built with the language it documents.
//
// This file is the recipe: each section below builds one part of the site,
// top to bottom. All page *content* lives in pages/ (and ../docs/ for the
// manuals) — this file only decides what gets built and where it goes.
// The page shell lives in layout.pars and the machinery (renderTree, link
// fixing, search indexing) in lib.pars. See README.md for the full map.

let {Layout} = import @./layout.pars
let {renderTree, rewriteLinks, writePage, escapeHtml, extractToc, searchEntry} = import @./lib.pars

let homePage = import @./pages/home.pars
let HomePage = homePage.HomePage
let notFoundPage = import @./pages/404.pars
let NotFoundPage = notFoundPage.NotFoundPage

let manualSrc = "../docs/parsley/manual"
let basilSrc = "../docs/basil/manual"
let distDir = @./dist

// --- clean --------------------------------------------------------------------
// Wipe dist/ first so pages deleted or renamed at source can't leave orphaned
// HTML behind. Everything below regenerates from scratch (including CNAME,
// install.sh, and assets, written near the end). rmdir is a no-op if dist/
// doesn't exist yet, so a first build works too.

dir(distDir).rmdir({recursive: true})

// --- homepage ----------------------------------------------------------------

let example <== text(@./examples/csv-page.pars)
let home = <Layout title={homePage.title} root="" path="index.html">
    <HomePage exampleHtml={escapeHtml(example)}/>
</Layout>
writePage(@./dist/index.html, home)

// --- site pages (site/pages/*.md, rendered at the site root) -----------------
// These share a small "About" sidebar — same layout as the docs, no switcher.

let aboutMenu = [{
    title: "About",
    links: [
        {href: "index.html", title: "Home"},
        {href: "get-started.html", title: "Get Started"},
        {href: "batteries-included.html", title: "Batteries Included"},
        {href: "performance.html", title: "Performance"},
        {href: "security.html", title: "Security"},
        {href: "why.html", title: "Why?"},
    ],
}]

let pageFiles = fileList("./pages/*.md")
let sitePageEntries = for (f in pageFiles) {
    let doc <== MD(f.path, {ids: true})
    let name = f.path.stem
    let title = if (doc.md.title != null) { doc.md.title } else { name }
    let html = rewriteLinks(doc.html)
    let page = <Layout title={title + " — Basil & Parsley"} root="" path={name + ".html"}
        menu={aboutMenu} base="" active={name + ".html"} toc={extractToc(html)}>
        <article>html</article>
    </Layout>
    writePage(@(./dist/{name}.html), page)
    searchEntry(title, name + ".html", "About", html)
}

// --- documentation trees -------------------------------------------------------

// Parsley manual sources link into the Basil manual (the @basil/* handler
// modules live there); remap those for the site's flatter layout, dropping one
// "../" and the "manual/" segment (docs/parsley/manual/… is deeper than /manual).
// Longest match first so the depth-1 form isn't partially rewritten.
// (Links to the standalone CHEATSHEET / error-codes pages need no remapping:
// those render at the site root, mirroring docs/parsley/ → dist/.)
let fixParsleyLinks = fn(html) {
    html.replace("../../../basil/manual/", "../../basil/")
        .replace("../../basil/manual/", "../basil/")
}
let parsleyTree = renderTree(manualSrc, "manual", "Parsley Manual", "parsley", fixParsleyLinks)

// Basil manual sources link into the Parsley manual and up to reference.md;
// remap those for the site's flatter layout (/manual and /basil).
let fixBasilLinks = fn(html) {
    html.replace("../../parsley/manual/", "../manual/")
        .replace("../reference.md", "reference.md")
        .replace("../reference.html", "reference.html")
}
let basilTree = renderTree(basilSrc, "basil", "Basil Manual", "basil", fixBasilLinks)

// The full server-side Parsley reference renders alongside the manual,
// reusing the Basil sidebar (it's linked from the Basil manual's index)
let refDoc <== MD(@../docs/basil/reference.md, {ids: true})
// reference.md sits at docs/basil/ and links into both manuals. The Basil
// manual is flattened to /basil, so collapse the "manual/" segment on every
// such link; the Parsley manual flattens to /manual and its standalone pages
// (error-codes) render at the site root, so remap those cross-links too.
let refHtml = rewriteLinks(refDoc.html)
    .replace(/"manual\/([^"]+\.html)"/g, "\"${1}\"")
    .replace("../parsley/manual/", "../manual/")
    .replace("../parsley/error-codes.html", "../error-codes.html")
let refPage = <Layout title="Basil Server Reference" root="../" path="basil/reference.html"
    menu={basilTree.menu} base="../basil/" active="reference.html" switcher="basil"
    toc={extractToc(refHtml)}>
    <article>refHtml</article>
</Layout>
writePage(@./dist/basil/reference.html, refPage)

// Standalone Parsley pages that live outside the manual tree, at the parsley
// root (docs/parsley/{CHEATSHEET,error-codes}.md) but linked from it. They
// render at the site root — mirroring docs/parsley/ → dist/ — so the manual's
// existing "../CHEATSHEET.md" / "../../error-codes.md" links resolve unchanged.
// They reuse the Parsley sidebar (base "manual/") like the reference page.
let renderStandalone = fn(srcPath, outName, title) {
    let doc <== MD(srcPath, {ids: true})
    let html = fixParsleyLinks(rewriteLinks(doc.html))
    let page = <Layout title={title + " — Parsley Manual"} root="" path={outName}
        menu={parsleyTree.menu} base="manual/" active={outName} switcher="parsley"
        toc={extractToc(html)}>
        <article>html</article>
    </Layout>
    writePage(@(./dist/{outName}), page)
    searchEntry(title, outName, "Parsley Manual", html)
}
let cheatsheetEntry = renderStandalone(@../docs/parsley/CHEATSHEET.md, "CHEATSHEET.html", "Parsley Cheatsheet")
let errorCodesEntry = renderStandalone(@../docs/parsley/error-codes.md, "error-codes.html", "Error Codes Reference")

// --- search index ----------------------------------------------------------
// One JSON file the search box fetches lazily; scoring happens client-side.

let searchIndex = parsleyTree.entries ++ basilTree.entries ++ sitePageEntries ++
    [searchEntry("Basil Server Reference", "basil/reference.html", "Basil Manual", refHtml),
     cheatsheetEntry, errorCodesEntry]
searchIndex ==> JSON(@./dist/search-index.json)

// --- assets & static files -----------------------------------------------------

dir(@./dist/assets).mkdir({parents: true})
let assetFiles = fileList("./assets/*.css") ++ fileList("./assets/*.js") ++ fileList("./assets/*.svg")
for (f in assetFiles) {
    let content <== f
    content ==> text(@(./dist/assets/{f.path.filename}))
}

// Custom domain for GitHub Pages, and the installer served from the site root
"herbaceous.net" ==> text(@./dist/CNAME)
let installer <== text(@../scripts/install.sh)
installer ==> text(@./dist/install.sh)

// Pages serves 404.html for unknown routes (content in pages/404.pars)
let notFound = <Layout title={notFoundPage.title} root="" path="404.html">
    <NotFoundPage/>
</Layout>
writePage(@./dist/404.html, notFound)

"Built " + (parsleyTree.count + basilTree.count + sitePageEntries.length() + 3) + " pages into " + distDir.string + ", indexed " + searchIndex.length() + " for search"
